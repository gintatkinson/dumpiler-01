        attribute pi_t : String = "Temporal projection operator mapping world-volume to 1D temporal extent";
        attribute lambda_t : String = "One-dimensional Lebesgue measure over temporal dimension";
        attribute sqsubseteq : String = "Spatio-temporal portioning partial order relation";
        attribute delta : String = "Guarded state transition function over events $``Sigma_{	ext{event}}``$";
