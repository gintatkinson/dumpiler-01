        attribute mathcal_mathcal : String = "Lowered `AllocationDefinition` and `AllocationUsage` records";
        attribute V_S_V_T : String = "Disjoint source and target sets ($``V_S cap V_T = emptyset``$)";
        attribute E : String = "Bipartite allocation relation edges $``E_{	ext{alloc}} subseteq V_S 	imes V_T``$";
        attribute text_tau : String = "Port directionality and payload data type";
        attribute G_E : String = "Workflow multigraph and unified step dependency edges";
        attribute delta_tau_mu : String = "Parameter directionality, type, and multiplicity interval";
        attribute sqsubset : String = "Irreflexive child-to-parent containment relation";
        attribute mathcal_s : String = "Orthogonal regions $``{ R_1, dots, R_k }``$ of parallel state $s$";
        attribute mathbf : String = "Active state configuration Cartesian product vector";
        attribute text_S : String = "Least common ancestor state bounding exit/entry ladders";
        attribute Delta_t : String = "UUIDv5 identifier from $``	ext{NS}_{	ext{DEAP}}``$ and FQN";
        attribute text_text_text : String = "Hook selector projections for state $S$";
        attribute t : String = "Bounded residence interval of state $S$";
        attribute sigma : String = "Status $in { 	ext{Pending}, 	ext{Executing}, 	ext{Completed}, 	ext{Aborted} }$";
        attribute f_D_mathcal : String = "Pure function and semantic value domain of type $T$";
        attribute mathcal_D_p_D : String = "Input parameter sequence and designated return parameter";
        attribute mathcal_u_G : String = "Argument binding map and calculation dependency DAG $``(V_{	ext{calc}}, E_{	ext{calc}})``$";
        attribute mathbf_mathbf : String = "Formal parameters and argument expressions";
        attribute e : String = "Predicate expression root node";
        attribute Phi : String = "Asserted Boolean predicate expression";
        attribute p_a : String = "Formal subject parameter and bound actual argument";
        attribute e_e : String = "Assumption and guarantee predicate expressions";
